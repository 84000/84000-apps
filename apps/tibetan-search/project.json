{
  "name": "tibetan-search",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/tibetan-search/src",
  "projectType": "application",
  "tags": [],
  "targets": {
    "typecheck": {
      "command": "tsc --noEmit -p tsconfig.app.json",
      "options": { "cwd": "apps/tibetan-search" },
      "cache": true
    },
    "bundle": {
      "command": "node apps/tibetan-search/build.mjs bundle",
      "outputs": ["{workspaceRoot}/dist/apps/tibetan-search/tibetan-search.mjs"]
    },
    "compile": {
      "command": "node apps/tibetan-search/build.mjs compile",
      "outputs": ["{workspaceRoot}/dist/apps/tibetan-search/bin"]
    }
  }
}
