{
  "name": "policy-editor-mcp-app",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/policy-editor-mcp-app/src",
  "projectType": "application",
  "tags": [],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "production",
        "^production",
        "!{projectRoot}/generated/**/*",
        "{workspaceRoot}/libs/design-system/src/lib/assets/fonts/MonlamUniOuChan2.woff2",
        {
          "externalDependencies": [
            "vite",
            "vite-plugin-singlefile",
            "tailwindcss",
            "@tailwindcss/postcss",
            "tw-animate-css",
            "@modelcontextprotocol/ext-apps"
          ]
        }
      ],
      "outputs": [
        "{workspaceRoot}/dist/apps/policy-editor-mcp-app",
        "{projectRoot}/generated"
      ],
      "options": {
        "command": "vite build --config apps/policy-editor-mcp-app/vite.config.mjs"
      }
    }
  }
}
